# Builds the backend from source for docker-compose.local.yml: no local Java/Maven and no image from the registry.
# CI uses Dockerfile, which only packages the jar that Maven built beforehand.
FROM maven:3.9-eclipse-temurin-25 AS build

WORKDIR /build
COPY pom.xml ./
COPY src ./src
# Cache mount keeps the Maven repository between builds
RUN --mount=type=cache,target=/root/.m2 mvn -B -DskipTests package

FROM eclipse-temurin:25-jre

WORKDIR /app
COPY --from=build /build/target/backend-*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
