# Copy to .env (git-ignored, never commit it), see Docs/deployment.md.

# --- Local run (docker-compose.local.yml), read automatically by docker compose ---
# Secrets for the local run only. In the Swarm stack they are Docker secrets (nfv_postgres_password,
# nfv_paypal_client_id, nfv_paypal_client_secret, nfv_idp_signing_key, nfv_openai_api_key, nfv_liteapi_api_key).
POSTGRES_PASSWORD=change-me
# Optional, without them the PayPal features answer 503
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, key signing the tokens of the IdP: PKCS#8 RSA, Base64 in one line without the PEM header lines
# (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | grep -v -- ----- | tr -d "\r\n"),
# without it all logins and MCP connections become invalid on restart
NFV_IDP_SIGNING_KEY=
# Optional, OpenAI API key for reading booking confirmations, without it bookings are entered manually
OPENAI_API_KEY=
# Optional, LiteAPI key (sandbox keys start with sand_) for alternative accommodations, paid with PayPal
LITEAPI_API_KEY=
# Host port of PostgreSQL, e.g. for a database tool
LOCAL_POSTGRES_PORT=5432
# Host ports of frontend and backend, default 18173 and 18180. The backend URL is the issuer of the tokens and is built
# into the frontend, so rebuild with up --build after a change
#LOCAL_FRONTEND_PORT=18173
#LOCAL_BACKEND_PORT=18180
# Optional, URL of the frontend as seen by the browser, default http://localhost:18173. PayPal sandbox rejects localhost
# as return URL, use the https URL of an ngrok tunnel to port 18173 (ngrok http 18173), see Docs/paypal.md
#LOCAL_FRONTEND_URL=https://example.ngrok-free.app

# --- Swarm stack (docker-compose.yml) ---
# "docker stack deploy" does not read .env, load it into the shell first:  set -a; . ./.env; set +a
BACKEND_IMAGE=ghcr.io/kehrbros/nofrustrationvacation/backend:main
FRONTEND_IMAGE=ghcr.io/kehrbros/nofrustrationvacation/frontend:main
CADDY_IMAGE=ghcr.io/kehrbros/nofrustrationvacation/caddy:main

# Domain of the app (DNS record to the server, ports 80/443 open). Caddy gets the Let's Encrypt certificate,
# frontend, IdP, API and MCP endpoint (https://${DOMAIN}/mcp) share the origin https://${DOMAIN}
DOMAIN=app.example.org

# Both: sandbox | live
PAYPAL_ENVIRONMENT=sandbox

# Host directory with osm/ (extract, copied by hand) and graphs/, see Docs/network.md.
# Swarm stack: required (the CI deployment sets it from the GitHub variable). Local run: optional, default ~/data
#NFV_HOST_DATA_DIR=/home/deploy/data
# Local run only, optional: false skips the road network import on start (routing answers 503)
#NFV_NETWORK_IMPORT_ON_START=false

# Optional: true enables the test endpoints /api/v1/test/traffic-events (role tester), default false. Never in production.
# Swarm stack: the CI deployment sets it from the GitHub variable of the same name.
#NFV_MANUAL_SOURCE_ENABLED=true
