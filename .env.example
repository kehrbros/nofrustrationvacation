# Variables of docker-compose.yml, see Docs/deployment.md. Copy to .env (git-ignored) and load it into the shell
# before "docker stack deploy", which does not read .env itself:  set -a; . ./.env; set +a
# No secrets here, they are Docker secrets (vacantagent_paypal_client_id, vacantagent_paypal_client_secret,
# vacantagent_encryption_key).

BACKEND_IMAGE=ghcr.io/kehrbros/vacantagent/backend:main
FRONTEND_IMAGE=ghcr.io/kehrbros/vacantagent/frontend:dev

# Public URLs as seen by the browser
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost

BACKEND_PORT=8080
FRONTEND_PORT=80

# sandbox | live
PAYPAL_ENVIRONMENT=sandbox
