# Copy to .env (git-ignored, never commit it), see Docs/deployment.md.

# --- Local run (docker-compose.local.yml), read automatically by docker compose ---
# Secrets for the local run only. In the Swarm stack they are Docker secrets (vacantagent_postgres_password,
# vacantagent_paypal_client_id, vacantagent_paypal_client_secret, vacantagent_idp_signing_key).
POSTGRES_PASSWORD=change-me
# Optional, without them the PayPal features answer 503
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, key signing the tokens of the IdP: PKCS#8 RSA, Base64 in one line without the PEM header lines
# (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | grep -v -- ----- | tr -d "\r\n"),
# without it all logins and MCP connections become invalid on restart
VACANTAGENT_IDP_SIGNING_KEY=
# Host port of PostgreSQL, e.g. for a database tool
LOCAL_POSTGRES_PORT=5432
# Optional, legacy: base of the PayPal return URLs (former web frontend), default http://localhost:5173
#LOCAL_FRONTEND_URL=

# --- Swarm stack (docker-compose.yml) ---
# "docker stack deploy" does not read .env, load it into the shell first:  set -a; . ./.env; set +a
BACKEND_IMAGE=ghcr.io/kehrbros/vacantagent/backend:main

# Public URL of the backend, also used by the app (EXPO_PUBLIC_BACKEND_URL, see frontend/README.md). MCP clients
# (Claude, ChatGPT) require it to be https and reachable from the internet, the MCP endpoint is ${BACKEND_URL}/mcp
BACKEND_URL=http://localhost:8080
# Legacy, base of the PayPal return URLs of the former web frontend
FRONTEND_URL=http://localhost

BACKEND_PORT=8080

# Both: sandbox | live
PAYPAL_ENVIRONMENT=sandbox
