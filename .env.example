# Copy to .env (git-ignored, never commit it), see Docs/deployment.md.

# --- Local run (docker-compose.local.yml), read automatically by docker compose ---
# Secrets for the local run only. In the Swarm stack they are Docker secrets (vacantagent_postgres_password,
# vacantagent_paypal_client_id, vacantagent_paypal_client_secret, vacantagent_encryption_key,
# vacantagent_idp_signing_key).
POSTGRES_PASSWORD=change-me
# Optional, without them the PayPal features answer 503
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, 32 random bytes Base64 (openssl rand -base64 32), without it stored agent API keys are lost on restart
VACANTAGENT_ENCRYPTION_KEY=
# Optional, key signing the tokens of the IdP: PKCS#8 RSA, Base64 in one line without the PEM header lines
# (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | grep -v -- ----- | tr -d "\r\n"),
# without it all logins and MCP connections become invalid on restart
VACANTAGENT_IDP_SIGNING_KEY=
# Host port of PostgreSQL, e.g. for a database tool
LOCAL_POSTGRES_PORT=5432
# Optional, URL of the frontend as seen by the browser, default http://localhost:5173. PayPal sandbox rejects localhost
# as return URL, use a host that resolves to 127.0.0.1 via HTTPS (port 5443, self-signed), see Docs/paypal.md
#LOCAL_FRONTEND_URL=https://localtest.me:5443

# --- Swarm stack (docker-compose.yml) ---
# "docker stack deploy" does not read .env, load it into the shell first:  set -a; . ./.env; set +a
BACKEND_IMAGE=ghcr.io/kehrbros/vacantagent/backend:main
FRONTEND_IMAGE=ghcr.io/kehrbros/vacantagent/frontend:dev

# Public URLs as seen by the browser. MCP clients (Claude, ChatGPT) require BACKEND_URL to be https and reachable
# from the internet, the MCP endpoint is ${BACKEND_URL}/mcp
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost

BACKEND_PORT=8080
FRONTEND_PORT=80

# Both: sandbox | live
PAYPAL_ENVIRONMENT=sandbox
