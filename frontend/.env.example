# Copy to .env.local (git-ignored). Expo inlines EXPO_PUBLIC_* variables into the app bundle, never put secrets here.

# Backend and issuer of the own IdP, must equal VACANTAGENT_BACKEND_URL of the backend. Android emulator: keep
# localhost and run "adb reverse tcp:8080 tcp:8080". Phone in the LAN: http://<IP of the PC>:8080 and start the backend
# with VACANTAGENT_BACKEND_URL set to the same URL.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
# Optional, issuer of the IdP if it is not the backend (e.g. Keycloak), default EXPO_PUBLIC_BACKEND_URL
#EXPO_PUBLIC_OIDC_ISSUER=
# Optional, OIDC client of the app, default vacantagent-app
#EXPO_PUBLIC_OIDC_CLIENT_ID=vacantagent-app
