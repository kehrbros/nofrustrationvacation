{
  "openapi" : "3.1.0",
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "oauth2" : [ ]
  } ],
  "tags" : [ {
    "description" : "Link the PayPal account for payouts",
    "name" : "Payout account"
  }, {
    "description" : "Pay out earnings via PayPal",
    "name" : "Payouts"
  }, {
    "description" : "Steps before a user can act in a role",
    "name" : "Onboarding"
  }, {
    "description" : "Top up platform credit via PayPal",
    "name" : "Top-ups"
  }, {
    "description" : "LLM accesses of providers",
    "name" : "Agents"
  }, {
    "description" : "Place and cancel consumer orders and provider offers",
    "name" : "Market"
  }, {
    "description" : "Balances and bookings of the authenticated user",
    "name" : "Accounting"
  } ],
  "paths" : {
    "/.well-known/oauth-protected-resource" : {
      "get" : {
        "operationId" : "metadata_1",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : { }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "protected-resource-metadata-controller" ]
      }
    },
    "/.well-known/oauth-protected-resource/mcp" : {
      "get" : {
        "operationId" : "metadata",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : { }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "protected-resource-metadata-controller" ]
      }
    },
    "/api/v1/accounting/balances" : {
      "get" : {
        "description" : "Credit rounded commercially, earnings rounded down (what can be paid out).",
        "operationId" : "getBalances",
        "parameters" : [ {
          "description" : "ISO 4217 code, defaults to the preferred currency",
          "in" : "query",
          "name" : "currency",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BalancesDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Credit and earnings",
        "tags" : [ "Accounting" ]
      }
    },
    "/api/v1/accounting/entries" : {
      "get" : {
        "description" : "The 50 latest bookings on all accounts of the user, newest first.",
        "operationId" : "getEntries",
        "parameters" : [ {
          "description" : "ISO 4217 code, defaults to the preferred currency",
          "in" : "query",
          "name" : "currency",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/LedgerEntryDto"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Latest bookings",
        "tags" : [ "Accounting" ]
      }
    },
    "/api/v1/accounting/payout-account" : {
      "delete" : {
        "description" : "Offers can no longer be placed afterwards.",
        "operationId" : "unlinkPayoutAccount",
        "responses" : {
          "204" : {
            "description" : "Unlinked or nothing was linked"
          },
          "409" : {
            "description" : "Payouts are still in progress (PAYOUTS_OPEN)"
          }
        },
        "summary" : "Unlink the payout account",
        "tags" : [ "Payout account" ]
      },
      "get" : {
        "description" : "Also tells whether PayPal is available on the server.",
        "operationId" : "getPayoutAccount",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayoutAccountStatusDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Linked payout account",
        "tags" : [ "Payout account" ]
      }
    },
    "/api/v1/accounting/payout-account/paypal" : {
      "post" : {
        "description" : "Replaces a PayPal account linked before.",
        "operationId" : "completePayPalLink",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PayPalLinkDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayoutAccountStatusDto"
                }
              }
            },
            "description" : "Linked"
          },
          "400" : {
            "description" : "State unknown, expired or of another user (LINK_STATE_INVALID)"
          },
          "409" : {
            "description" : "PayPal account linked to another user (PAYPAL_ACCOUNT_IN_USE)"
          },
          "502" : {
            "description" : "PayPal refused the code or could not be reached"
          }
        },
        "summary" : "Complete linking a PayPal account",
        "tags" : [ "Payout account" ]
      }
    },
    "/api/v1/accounting/payout-account/paypal/authorization" : {
      "post" : {
        "description" : "Returns the PayPal login URL. PayPal sends the user back to the configured redirect URI with code and state, which the frontend passes to POST /payout-account/paypal within 15 minutes.",
        "operationId" : "startPayPalLink",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayPalAuthorizationDto"
                }
              }
            },
            "description" : "Send the user to authorizationUrl"
          },
          "503" : {
            "description" : "PayPal is not configured"
          }
        },
        "summary" : "Start linking a PayPal account",
        "tags" : [ "Payout account" ]
      }
    },
    "/api/v1/accounting/payouts" : {
      "get" : {
        "description" : "The 20 latest payouts, newest first.",
        "operationId" : "getPayouts",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PayoutDto"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Latest payouts",
        "tags" : [ "Payouts" ]
      },
      "post" : {
        "description" : "Debits the earnings and sends the amount to the linked PayPal account. PayPal processes payouts asynchronously: SUBMITTED becomes COMPLETED or FAILED (booked back) later.",
        "operationId" : "requestPayout",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PayoutRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayoutDto"
                }
              }
            },
            "description" : "Payout created, see status"
          },
          "400" : {
            "description" : "Invalid amount or unsupported currency (INVALID_AMOUNT)"
          },
          "409" : {
            "description" : "No PayPal account linked (PAYOUT_ACCOUNT_REQUIRED) or earnings too low (INSUFFICIENT_BALANCE)"
          },
          "422" : {
            "description" : "Amount below the minimum (AMOUNT_OUT_OF_RANGE)"
          }
        },
        "summary" : "Request a payout",
        "tags" : [ "Payouts" ]
      }
    },
    "/api/v1/accounting/top-ups" : {
      "get" : {
        "description" : "The 20 latest top-ups, newest first.",
        "operationId" : "getTopUps",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TopUpDto"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Latest top-ups",
        "tags" : [ "Top-ups" ]
      },
      "post" : {
        "description" : "Creates a PayPal order over the amount. Send the user to approveUrl; PayPal returns to the configured return URL with the order id as query parameter token, then call capture.",
        "operationId" : "startTopUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/TopUpRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TopUpStartedDto"
                }
              }
            },
            "description" : "PayPal order created"
          },
          "400" : {
            "description" : "Invalid amount or unsupported currency (INVALID_AMOUNT)"
          },
          "422" : {
            "description" : "Amount below the minimum or above the maximum (AMOUNT_OUT_OF_RANGE)"
          },
          "503" : {
            "description" : "PayPal not configured or no current exchange rate"
          }
        },
        "summary" : "Start a top-up",
        "tags" : [ "Top-ups" ]
      }
    },
    "/api/v1/accounting/top-ups/paypal/{orderId}/cancel" : {
      "post" : {
        "description" : "After the user cancelled at PayPal. Paid top-ups stay as they are.",
        "operationId" : "cancelTopUp",
        "parameters" : [ {
          "description" : "PayPal order id, query parameter token of the cancel URL",
          "in" : "path",
          "name" : "orderId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "No top-up of the user for this order (TOP_UP_NOT_FOUND)"
          }
        },
        "summary" : "Cancel a top-up",
        "tags" : [ "Top-ups" ]
      }
    },
    "/api/v1/accounting/top-ups/paypal/{orderId}/capture" : {
      "post" : {
        "description" : "Idempotent. Status COMPLETED means credited; PENDING is credited automatically once PayPal releases the money.",
        "operationId" : "captureTopUp",
        "parameters" : [ {
          "description" : "PayPal order id, query parameter token of the return URL",
          "in" : "path",
          "name" : "orderId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TopUpDto"
                }
              }
            },
            "description" : "Current state of the top-up"
          },
          "404" : {
            "description" : "No top-up of the user for this order (TOP_UP_NOT_FOUND)"
          },
          "422" : {
            "description" : "Not approved or declined (PAYMENT_NOT_APPROVED, PAYMENT_DECLINED)"
          }
        },
        "summary" : "Capture an approved top-up",
        "tags" : [ "Top-ups" ]
      }
    },
    "/api/v1/agents" : {
      "get" : {
        "operationId" : "getAgents",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AgentDto"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "My agents",
        "tags" : [ "Agents" ]
      },
      "post" : {
        "description" : "The API key is stored encrypted and never returned.",
        "operationId" : "createAgent",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateAgentDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentDto"
                }
              }
            },
            "description" : "Created"
          },
          "400" : {
            "description" : "Field missing, API key too short or baseUrl not https"
          }
        },
        "summary" : "Add an agent",
        "tags" : [ "Agents" ]
      }
    },
    "/api/v1/agents/{id}" : {
      "delete" : {
        "operationId" : "deleteAgent",
        "parameters" : [ {
          "description" : "Agent id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed"
          },
          "404" : {
            "description" : "Unknown or of another user"
          },
          "409" : {
            "description" : "Still used by offers"
          }
        },
        "summary" : "Remove an agent",
        "tags" : [ "Agents" ]
      }
    },
    "/api/v1/agents/{id}/api-key" : {
      "put" : {
        "operationId" : "changeApiKey",
        "parameters" : [ {
          "description" : "Agent id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ApiKeyDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "description" : "Unknown or of another user"
          }
        },
        "summary" : "Replace the API key of an agent",
        "tags" : [ "Agents" ]
      }
    },
    "/api/v1/market/offers" : {
      "post" : {
        "description" : "Matched against the highest-paying fitting order for the model of its agent. If none fits, the offer waits in the market until offeredUntil.",
        "operationId" : "placeOffer",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OfferDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Matched (agreement included) or waiting in the market"
          },
          "400" : {
            "description" : "agentId missing or not an agent of the user, or unsupported currency"
          },
          "403" : {
            "description" : "Provider onboarding incomplete (PayPal account, agent), see /api/v1/onboarding/provider"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Rejected by the market rules, see reason"
          }
        },
        "summary" : "Place an offer",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/market/offers/{id}" : {
      "delete" : {
        "operationId" : "cancelOffer",
        "parameters" : [ {
          "description" : "Offer id from placing it",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed from the market"
          },
          "404" : {
            "description" : "Not waiting: already matched, cancelled, expired, unknown or placed by another user"
          }
        },
        "summary" : "Cancel a waiting offer",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/market/orders" : {
      "post" : {
        "description" : "Matched against the cheapest fitting offer for the requested model. If none fits, the order waits in the market for its marketWaitTime. A user may have only one waiting order per modelProvider and modelName. Both are trimmed, empty means any.",
        "operationId" : "placeOrder",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OrderDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Matched (agreement included) or waiting in the market"
          },
          "400" : {
            "description" : "modelName without modelProvider, or unsupported currency"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Rejected by the market rules, or the user already has an order waiting for this modelProvider and modelName, see reason"
          }
        },
        "summary" : "Place an order",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/market/orders/{id}" : {
      "delete" : {
        "operationId" : "cancelOrder",
        "parameters" : [ {
          "description" : "Order id from placing it",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed from the market"
          },
          "404" : {
            "description" : "Not waiting: already matched, cancelled, expired, unknown or placed by another user"
          }
        },
        "summary" : "Cancel a waiting order",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/onboarding/provider" : {
      "get" : {
        "description" : "Registration, PayPal account for payouts, at least one agent with API key. Offers require all.",
        "operationId" : "getProviderOnboarding",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProviderOnboardingDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Provider onboarding checklist",
        "tags" : [ "Onboarding" ]
      }
    },
    "/api/v1/users/me" : {
      "get" : {
        "operationId" : "getProfile",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppUserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "user-controller" ]
      }
    },
    "/api/v1/users/me/preferred-currency" : {
      "put" : {
        "operationId" : "changePreferredCurrency",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PreferredCurrencyDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppUserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "user-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AgentDto" : {
        "type" : "object",
        "properties" : {
          "apiKeyHint" : {
            "type" : "string",
            "example" : "x7Qa"
          },
          "baseUrl" : {
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "modelProvider" : {
            "type" : "string",
            "example" : "openai"
          },
          "name" : {
            "type" : "string",
            "example" : "gpt-5"
          }
        },
        "required" : [ "apiKeyHint", "createdAt", "id", "modelProvider", "name" ]
      },
      "AgreementDto" : {
        "type" : "null",
        "properties" : {
          "agreedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "agreedPricePerMillionInputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "agreedPricePerMillionOutputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "consumerOrderId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "modelName" : {
            "type" : "string",
            "example" : "gpt-5"
          },
          "modelProvider" : {
            "type" : "string",
            "example" : "openai"
          },
          "providerOfferId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "validUntil" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "The offer's offeredUntil, missing means no end"
          }
        }
      },
      "ApiKeyDto" : {
        "type" : "object",
        "properties" : {
          "apiKey" : {
            "type" : "string",
            "format" : "password"
          }
        },
        "required" : [ "apiKey" ]
      },
      "AppUserDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "preferredCurrency" : {
            "type" : [ "string", "null" ]
          },
          "username" : {
            "type" : "string"
          }
        }
      },
      "BalancesDto" : {
        "type" : "object",
        "properties" : {
          "credit" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "earnings" : {
            "$ref" : "#/components/schemas/MoneyDto"
          }
        },
        "required" : [ "credit", "earnings" ]
      },
      "CreateAgentDto" : {
        "type" : "object",
        "properties" : {
          "apiKey" : {
            "type" : "string",
            "format" : "password"
          },
          "baseUrl" : {
            "type" : [ "string", "null" ]
          },
          "modelProvider" : {
            "type" : "string",
            "example" : "openai"
          },
          "name" : {
            "type" : "string",
            "example" : "gpt-5"
          }
        },
        "required" : [ "apiKey", "modelProvider", "name" ]
      },
      "LedgerEntryDto" : {
        "type" : "object",
        "properties" : {
          "account" : {
            "type" : "string",
            "enum" : [ "CREDIT", "EARNINGS" ]
          },
          "amount" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "bookedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
