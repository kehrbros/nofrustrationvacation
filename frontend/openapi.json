{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "description" : "Place and cancel consumer orders and provider offers",
    "name" : "Market"
  } ],
  "paths" : {
    "/api/v1/market/offers" : {
      "post" : {
        "description" : "Matched against the highest-paying fitting order for its model. If none fits, the offer waits in the market until offeredUntil.",
        "operationId" : "placeOffer",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OfferDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Matched (agreement included) or waiting in the market"
          },
          "400" : {
            "description" : "modelProvider or modelName missing, or unsupported currency"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Rejected by the market rules, see reason"
          }
        },
        "summary" : "Place an offer",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/market/offers/{id}" : {
      "delete" : {
        "operationId" : "cancelOffer",
        "parameters" : [ {
          "description" : "Offer id from placing it",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed from the market"
          },
          "404" : {
            "description" : "Not waiting: already matched, cancelled, expired, unknown or placed by another user"
          }
        },
        "summary" : "Cancel a waiting offer",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/market/orders" : {
      "post" : {
        "description" : "Matched against the cheapest fitting offer for the requested model. If none fits, the order waits in the market for its marketWaitTime. A user may have only one waiting order per modelProvider and modelName. Both are trimmed, empty means any.",
        "operationId" : "placeOrder",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OrderDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Matched (agreement included) or waiting in the market"
          },
          "400" : {
            "description" : "modelName without modelProvider, or unsupported currency"
          },
          "422" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubmissionDto"
                }
              }
            },
            "description" : "Rejected by the market rules, or the user already has an order waiting for this modelProvider and modelName, see reason"
          }
        },
        "summary" : "Place an order",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/market/orders/{id}" : {
      "delete" : {
        "operationId" : "cancelOrder",
        "parameters" : [ {
          "description" : "Order id from placing it",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Removed from the market"
          },
          "404" : {
            "description" : "Not waiting: already matched, cancelled, expired, unknown or placed by another user"
          }
        },
        "summary" : "Cancel a waiting order",
        "tags" : [ "Market" ]
      }
    },
    "/api/v1/users/me" : {
      "get" : {
        "operationId" : "getProfile",
        "parameters" : [ {
          "description" : "ISO 4217 code of the currency for monetary values, defaults to the preferred currency",
          "in" : "query",
          "name" : "currency",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppUserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "user-controller" ]
      }
    },
    "/api/v1/users/me/preferred-currency" : {
      "put" : {
        "operationId" : "changePreferredCurrency",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PreferredCurrencyDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppUserDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "user-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AgreementDto" : {
        "type" : "null",
        "properties" : {
          "agreedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "agreedPricePerMillionInputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "agreedPricePerMillionOutputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "consumerOrderId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "modelName" : {
            "type" : "string",
            "example" : "gpt-5"
          },
          "modelProvider" : {
            "type" : "string",
            "example" : "openai"
          },
          "providerOfferId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "validUntil" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "The offer's offeredUntil, missing means no end"
          }
        }
      },
      "AppUserDto" : {
        "type" : "object",
        "properties" : {
          "accountBalance" : {
            "$ref" : "#/components/schemas/MoneyDto"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "preferredCurrency" : {
            "type" : [ "string", "null" ]
          },
          "username" : {
            "type" : "string"
          }
        }
      },
      "MoneyDto" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "12.50"
          },
          "currency" : {
            "type" : "string",
            "description" : "ISO 4217 currency code",
            "example" : "EUR"
          },
          "exchangeRate" : {
            "type" : [ "string", "null" ],
            "format" : "decimal",
            "example" : "0.9187000000"
          },
          "exchangeRateDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          }
        },
        "required" : [ "amount", "currency" ]
      },
      "OfferDto" : {
        "type" : "object",
        "properties" : {
          "modelName" : {
            "type" : "string",
            "example" : "gpt-5"
          },
          "modelProvider" : {
            "type" : "string",
            "example" : "openai"
          },
          "offeredUntil" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "End of the offer and of any agreement made from it. Missing means no end."
          },
          "pricePerMillionInputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto",
            "description" : "Price per million input tokens"
          },
          "pricePerMillionOutputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto",
            "description" : "Price per million output tokens"
          },
          "totalTokens" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Tokens offered in total",
            "example" : 1000000
          }
        },
        "required" : [ "modelName", "modelProvider", "pricePerMillionInputTokens", "pricePerMillionOutputTokens" ]
      },
      "OrderDto" : {
        "type" : "object",
        "properties" : {
          "marketWaitTime" : {
            "type" : [ "string", "null" ],
            "format" : "duration",
            "description" : "How long the order waits in the market for a fitting offer (ISO 8601). Missing means it waits until cancelled, zero means it only matches on arrival.",
            "example" : "PT5M"
          },
          "maxCostPerMillionInputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto",
            "description" : "Highest accepted price per million input tokens"
          },
          "maxCostPerMillionOutputTokens" : {
            "$ref" : "#/components/schemas/MoneyDto",
            "description" : "Highest accepted price per million output tokens"
          },
          "modelName" : {
            "type" : [ "string", "null" ],
            "description" : "Only offers of this model. Missing means any model of modelProvider.",
            "example" : "gpt-5"
          },
          "modelProvider" : {
            "type" : [ "string", "null" ],
            "description" : "Only offers of this provider. Missing means any provider, then modelName must be missing too.",
            "example" : "openai"
          }
        },
        "required" : [ "maxCostPerMillionInputTokens", "maxCostPerMillionOutputTokens" ]
      },
      "PreferredCurrencyDto" : {
        "type" : "object",
        "properties" : {
          "currency" : {
            "type" : [ "string", "null" ],
            "example" : "EUR"
          }
        }
      },
      "SubmissionDto" : {
        "type" : "object",
        "properties" : {
          "agreement" : {
            "$ref" : "#/components/schemas/AgreementDto",
            "description" : "Only for MATCHED"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Id of the persisted order or offer, use it to cancel"
          },
          "reason" : {
            "type" : [ "string", "null" ],
            "description" : "Only for REJECTED"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "MATCHED", "RESTING", "REJECTED" ]
          }
        }
      }
    }
  }
}