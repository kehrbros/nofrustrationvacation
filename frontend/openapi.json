            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayoutDto"
                }
              }
            },
            "description" : "Payout created, see status"
          },
          "400" : {
            "description" : "Invalid amount or unsupported currency (INVALID_AMOUNT)"
          },
          "409" : {
            "description" : "No PayPal account linked (PAYOUT_ACCOUNT_REQUIRED) or earnings too low (INSUFFICIENT_BALANCE)"
          },
          "422" : {
            "description" : "Amount below the minimum (AMOUNT_OUT_OF_RANGE)"
          }
        },
        "summary" : "Request a payout",
        "tags" : [ "Payouts" ]
      }
    },
    "/api/v1/accounting/top-ups" : {
