    "/api/v1/accounting/payout-account/paypal" : {
      "post" : {
        "description" : "Replaces a PayPal account linked before.",
        "operationId" : "completePayPalLink",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PayPalLinkDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayoutAccountStatusDto"
                }
              }
            },
            "description" : "Linked"
          },
          "400" : {
            "description" : "State unknown, expired or of another user (LINK_STATE_INVALID)"
          },
          "409" : {
            "description" : "PayPal account linked to another user (PAYPAL_ACCOUNT_IN_USE)"
          },
          "502" : {
            "description" : "PayPal refused the code or could not be reached"
          }
        },
        "summary" : "Complete linking a PayPal account",
        "tags" : [ "Payout account" ]
      }
    },
    "/api/v1/accounting/payout-account/paypal/authorization" : {
      "post" : {
        "description" : "Returns the PayPal login URL. PayPal sends the user back to the configured redirect URI with code and state, which the frontend passes to POST /payout-account/paypal within 15 minutes.",
        "operationId" : "startPayPalLink",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PayPalAuthorizationDto"
                }
              }
            },
            "description" : "Send the user to authorizationUrl"
          },
          "503" : {
            "description" : "PayPal is not configured"
          }
        },
        "summary" : "Start linking a PayPal account",
        "tags" : [ "Payout account" ]
      }
    },
    "/api/v1/accounting/payouts" : {
      "get" : {
        "description" : "The 20 latest payouts, newest first.",
        "operationId" : "getPayouts",
