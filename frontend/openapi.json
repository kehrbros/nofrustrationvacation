                }
              }
            },
            "description" : "PayPal order created"
          },
          "400" : {
            "description" : "Invalid amount or unsupported currency (INVALID_AMOUNT)"
          },
          "422" : {
            "description" : "Amount below the minimum or above the maximum (AMOUNT_OUT_OF_RANGE)"
          },
          "503" : {
            "description" : "PayPal not configured or no current exchange rate"
          }
        },
